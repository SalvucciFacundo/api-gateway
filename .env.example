# JWT signing secret (required; the process exits when empty).
JWT_SECRET=replace-with-a-long-random-secret

# Admin user seeded idempotently on startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-development-password

# Server port.
PORT=8080

# Optional PostgreSQL persistence. Leave empty to use the in-memory store.
# When set, embedded goose migrations run automatically on startup.
# Docker Compose (service URL):
#   DATABASE_URL=postgres://postgres:postgres@postgres:5432/api_gateway?sslmode=disable
# Local development (localhost URL):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/api_gateway?sslmode=disable
DATABASE_URL=